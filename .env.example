# =====================================================================
# Configuración de Variables de Entorno - Escapadas en Tren
# =====================================================================

# Proveedor de alojamiento a utilizar: 'mock', 'rapidapi' o 'scraper'
# - mock: Datos simulados ultrarrápidos y realistas, sin cuotas de API (recomendado para desarrollo)
# - rapidapi: Conexión a agregadores (Booking.com / Airbnb vía RapidAPI)
# - scraper: Esqueleto para un scraper futuro (de momento delega en mock)
ACCOMMODATION_PROVIDER=mock

# Credenciales de RapidAPI (solo requerido si ACCOMMODATION_PROVIDER=rapidapi)
RAPIDAPI_KEY=tu_api_key_de_rapidapi_aqui
RAPIDAPI_HOST=booking-com15.p.rapidapi.com
# Horas que se reutilizan los precios en vivo antes de volver a consultar la API (ahorra cuota)
RAPIDAPI_PRICE_CACHE_HOURS=3

# Configuración de Rutas y Caché (las rutas relativas se resuelven desde la raíz del proyecto)
# Feed GTFS opcional (.zip o carpeta) con la red real; si se deja vacío se usa data/seed_routes.json
GTFS_PATH=
SQLITE_CACHE_DB=data/cache.db
CACHE_TTL_HOURS=24

# Parámetros por defecto de búsqueda
# Estación de origen preseleccionada (nombre, ciudad, alias o código, p. ej. "Santiago de Compostela")
DEFAULT_ORIGIN_STATION=València-Nord
DEFAULT_MAX_TRAVEL_HOURS=2.0
DEFAULT_MIN_TRANSFER_MARGIN_MINUTES=15
DEFAULT_MAX_TRANSFER_MARGIN_MINUTES=60
